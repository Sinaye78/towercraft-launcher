[Desktop Entry]
Version=1.0
Name=@Launcher_DisplayName@
Comment=Play on the TowerCraft Minecraft server
Type=Application
Terminal=false
Exec=@Launcher_APP_BINARY_NAME@ %U
StartupNotify=true
Icon=@Launcher_AppID@
Categories=Game;ActionGame;AdventureGame;Simulation;
Keywords=game;minecraft;mc;towercraft;
StartupWMClass=@Launcher_CommonName@
MimeType=application/zip;x-scheme-handler/prismlauncher;x-scheme-handler/@Launcher_APP_BINARY_NAME@;
